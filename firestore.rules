rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      // السماح بقراءة بيانات المستخدمين لأي مستخدم مسجل الدخول (لعرض الدكاترة)، والتعديل لصاحب الحساب أو الأدمن
      allow read: if isSignedIn();
      allow write: if (isSignedIn() && request.auth.uid == userId) || isAdmin();

      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      }
    }

    match /doctors/{doctorId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isSignedIn();
    }

    match /appointments/{appointmentId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // التخصصات (specialties)
    match /specialties/{specialtyId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
